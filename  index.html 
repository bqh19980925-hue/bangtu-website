<script>
// ===== DATA LAYER (LocalStorage) =====
const DB = {
  prefix: 'bt_',
  read(c) { const r = localStorage.getItem(this.prefix + c); return r ? JSON.parse(r) : []; },
  write(c, d) { localStorage.setItem(this.prefix + c, JSON.stringify(d)); },
  uid(p) { return p + '_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6); },
  // Companies
  getCompanies() { return this.read('companies'); },
  saveCompany(c) { const d = this.read('companies'); if (!c.id) c.id = this.uid('cmp'); d.push(c); this.write('companies', d); return c; },
  // Contacts
  getContacts() { return this.read('contacts'); },
  saveContact(c) { const d = this.read('contacts'); if (!c.id) c.id = this.uid('con'); d.push(c); this.write('contacts', d); return c; },
  // Leads
  getLeads() { return this.read('leads'); },
  saveLead(l) { const d = this.read('leads'); if (!l.id) l.id = this.uid('lea'); d.push(l); this.write('leads', d); return l; },
  updateLead(id, data) { const d = this.read('leads'); const i = d.findIndex(x => x.id === id); if (i > -1) { d[i] = { ...d[i], ...data }; this.write('leads', d); } },
  // Deals
  getDeals() { return this.read('deals'); },
  saveDeal(d) { const dd = this.read('deals'); if (!d.id) d.id = this.uid('deal'); dd.push(d); this.write('deals', dd); return d; },
  // Tasks
  getTasks() { return this.read('tasks'); },
  saveTask(t) { const d = this.read('tasks'); if (!t.id) t.id = this.uid('tsk'); d.push(t); this.write('tasks', d); return t; },
  // Quotes
  getQuotes() { return this.read('quotes'); },
  saveQuote(q) { const d = this.read('quotes'); if (!q.id) q.id = this.uid('quo'); d.push(q); this.write('quotes', d); return q; },
  // Orders
  getOrders() { return this.read('orders'); },
  saveOrder(o) { const d = this.read('orders'); if (!o.id) o.id = this.uid('ord'); d.push(d); this.write('orders', o); return o; },
  // Payments
  getPayments() { return this.read('payments'); },
  savePayment(p) { const d = this.read('payments'); if (!p.id) p.id = this.uid('pay'); d.push(p); this.write('payments', d); return p; },
  // Comms
  getComms() { return this.read('communications'); },
  saveComm(c) { const d = this.read('communications'); if (!c.id) c.id = this.uid('com'); d.push(c); this.write('communications', d); return c; },
  // Auth
  getUsers() { return JSON.parse(localStorage.getItem('bt_users') || '[]'); },
  saveUsers(u) { localStorage.setItem('bt_users', JSON.stringify(u)); },
  getSession() { return JSON.parse(localStorage.getItem('bt_session') || 'null'); },
  setSession(s) { localStorage.setItem('bt_session', JSON.stringify(s)); },
  clearSession() { localStorage.removeItem('bt_session'); }
};


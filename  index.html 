// ===== NAVIGATION =====
function showPage(name) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  const target = document.getElementById('page-' + name);
  if (target) target.classList.add('active');
  document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
  const navLink = document.querySelector(`[data-page="${name}"]`);
  if (navLink) navLink.classList.add('active');
  document.getElementById('nav-menu').classList.remove('open');
  window.scrollTo(0, 0);

  if (name === 'crm') {
    const s = DB.getSession();
    if (!s) { showPage('login'); return false; }
    document.getElementById('main-nav').style.display = 'none';
    document.getElementById('main-footer').style.display = 'none';
    document.getElementById('crm-user').textContent = s.username + ' (' + s.role + ')';
    crmView('dashboard');
  } else {
    document.getElementById('main-nav').style.display = '';
    document.getElementById('main-footer').style.display = '';
  }
  return true;
}

function toggleMenu() { document.getElementById('nav-menu').classList.toggle('open'); }

// ===== QUOTE SUBMIT =====
function submitQuote(e) {
  e.preventDefault();
  const f = document.getElementById('quote-form');
  const data = {
    name: f.name.value.trim(), company: f.company.value.trim(), country: f.country.value,
    email: f.email.value.trim(), whatsapp: f.whatsapp.value.trim(), product: f.product.value,
    quantity: f.quantity.value, targetMarket: f.targetMarket.value, message: f.message.value.trim()
  };
  // Create lead
  DB.saveLead({
    leadName: data.name + ' - ' + data.product, company: data.company, contact: data.name,
    source: 'Website Quote', country: data.country, product: data.product, status: 'New Lead',
    owner: '', nextFollowUp: '', notes: data.message
  });
  // Create company if new
  const companies = DB.getCompanies();
  if (!companies.find(c => c.name && c.name.toLowerCase() === data.company.toLowerCase())) {
    DB.saveCompany({ name: data.company, country: data.country, website: '', industry: '', contact: data.name, status: 'Prospect', notes: 'From website' });
  }
  // Create contact if new
  const contacts = DB.getContacts();
  if (!contacts.find(c => c.email === data.email)) {
    DB.saveContact({ name: data.name, company: data.company, position: '', email: data.email, whatsapp: data.whatsapp, linkedin: '', country: data.country, notes: 'Website quote' });
  }
  f.style.display = 'none';
  document.getElementById('quote-success').classList.remove('hidden');
  document.getElementById('quote-ref').textContent = 'Reference: LEAD_' + Date.now().toString().slice(-6);
}

// ===== LOGIN =====
function doLogin(e) {
  e.preventDefault();
  const f = e.target;
  const users = DB.getUsers();
  const u = users.find(x => x.username === f.username.value && x.password === f.password.value);
  if (u) {
    DB.setSession({ username: u.username, role: u.role, at: Date.now() });
    showPage('crm');
  } else {
    document.getElementById('login-error').textContent = 'Invalid credentials';
  }
}

function logout() { DB.clearSession(); showPage('home'); }

// ===== CRM VIEWS =====
function crmView(view, el) {
  if (el) { document.querySelectorAll('#crm-sidebar a').forEach(a => a.classList.remove('active')); el.classList.add('active'); }
  const main = document.getElementById('crm-main');
  switch (view) {
    case 'dashboard': main.innerHTML = crmDashboard(); break;
    case 'leads': main.innerHTML = crmList('leads', 'Leads', ['leadName','company','status','country','product']); break;
    case 'companies': main.innerHTML = crmList('companies', 'Companies', ['name','country','industry','status']); break;
    case 'contacts': main.innerHTML = crmList('contacts', 'Contacts', ['name','company','email','whatsapp']); break;
    case 'deals': main.innerHTML = crmList('deals', 'Deals', ['dealName','company','amount','stage','probability']); break;
    case 'tasks': main.innerHTML = crmList('tasks', 'Tasks', ['task','customer','dueDate','priority','status']); break;
    case 'quotes': main.innerHTML = crmList('quotes', 'Quotes', ['quoteNumber','customer','total','status']); break;
    case 'orders': main.innerHTML = crmList('orders', 'Orders', ['orderNumber','customer','amount','status']); break;
    case 'payments': main.innerHTML = crmList('payments', 'Payments', ['customer','amount','status','date']); break;
    case 'comms': main.innerHTML = crmList('communications', 'Communications', ['type','customer','subject','date']); break;
  }
}

function crmDashboard() {
  const leads = DB.getLeads(); const deals = DB.getDeals(); const tasks = DB.getTasks();
  const quotes = DB.getQuotes(); const orders = DB.getOrders(); const payments = DB.getPayments();
  const stages = ['New Lead','Contacted','Replied','Qualified','Quotation','Negotiation','Won','Lost'];
  const today = new Date().toISOString().slice(0,10);
  let pipelineHtml = stages.map(s => `<div class="pipeline-stage ${s==='Won'?'won':s==='Lost'?'lost':''}"><div class="count">${leads.filter(l=>l.status===s).length}</div><div>${s}</div></div>`).join('');
  return `<h2>Dashboard</h2>
    <div class="crm-stats">
      <div class="stat-card"><div class="num">${leads.filter(l=>l.status==='New Lead').length}</div><div class="label">New Leads</div></div>
      <div class="stat-card"><div class="num">${tasks.filter(t=>t.status!=='Done'&&t.dueDate<=today).length}</div><div class="label">Follow-ups Due</div></div>
      <div class="stat-card"><div class="num">${deals.filter(d=>!['Won','Lost'].includes(d.stage)).length}</div><div class="label">Active Deals</div></div>
      <div class="stat-card"><div class="num">${quotes.filter(q=>q.status==='Sent').length}</div><div class="label">Quotations</div></div>
      <div class="stat-card"><div class="num">${orders.filter(o=>o.status==='Confirmed').length}</div><div class="label">Orders</div></div>
      <div class="stat-card"><div class="num">${payments.filter(p=>p.status==='Paid').length}</div><div class="label">Payments</div></div>
    </div>
    <h3>Sales Pipeline</h3>
    <div class="pipeline-bar">${pipelineHtml}</div>
    <h3>Recent Leads</h3>
    <table><tr><th>Name</th><th>Company</th><th>Status</th><th>Product</th></tr>
    ${leads.slice(-5).reverse().map(l=>`<tr><td>${l.leadName||''}</td><td>${l.company||''}</td><td><span class="badge badge-new">${l.status||'New Lead'}</span></td><td>${l.product||''}</td></tr>`).join('')}
    </table>`;
}

function crmList(collection, title, fields) {
  const data = DB['get' + collection.charAt(0).toUpperCase() + collection.slice(0, -1) + 's'] ? DB['get' + collection.charAt(0).toUpperCase() + collection.slice(0, -1) + 's']() : DB.read(collection);
  let html = `<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;"><h2>${title}</h2><button class="btn btn-primary btn-sm" onclick="addRecord('${collection}')">+ Add</button></div>`;
  if (data.length === 0) { html += '<p class="muted">No records yet.</p>'; return html; }
  html += '<table><tr>' + fields.map(f => `<th>${f}</th>`).join('') + '<th>Action</th></tr>';
  data.forEach(r => {
    html += '<tr>' + fields.map(f => `<td>${r[f]||''}</td>`).join('') + `<td><button class="btn btn-sm btn-ghost" onclick="editRecord('${collection}','${r.id}')">Edit</button></td></tr>`;
  });
  html += '</table>';
  return html;
}

function addRecord(collection) {
  const modal = document.getElementById('modal');
  const content = document.getElementById('modal-content');
  content.innerHTML = `<h3>Add ${collection.slice(0,-1)}</h3><p class="muted small">Feature available in next update. Data saves automatically when submitted via website forms.</p><div class="modal-actions"><button class="btn btn-secondary" onclick="closeModal()">Close</button></div>`;
  modal.classList.add('open');
}

function editRecord(collection, id) {
  const data = DB.read(collection);
  const r = data.find(x => x.id === id);
  if (!r) return;
  const modal = document.getElementById('modal');
  const content = document.getElementById('modal-content');
  let fields = '';
  for (const [k, v] of Object.entries(r)) {
    if (k === 'id' || k === 'createdAt' || k === 'updatedAt') continue;
    fields += `<label>${k}<input id="edit-${k}" value="${v||''}"></label>`;
  }
  content.innerHTML = `<h3>Edit ${collection.slice(0,-1)}</h3><form class="form" onsubmit="saveEdit(event,'${collection}','${id}')">${fields}<div class="modal-actions"><button type="button" class="btn btn-secondary" onclick="closeModal()">Cancel</button><button type="submit" class="btn btn-primary">Save</button></div></form>`;
  modal.classList.add('open');
}

function saveEdit(e, collection, id) {
  e.preventDefault();
  const data = DB.read(collection);
  const r = data.find(x => x.id === id);
  if (r) {
    for (const key of Object.keys(r)) {
      if (key === 'id' || key === 'createdAt') continue;
      const el = document.getElementById('edit-' + key);
      if (el) r[key] = el.value;
    }
    r.updatedAt = new Date().toISOString();
    DB.write(collection, data);
  }
  closeModal();
  crmView(collection);
}

function closeModal() { document.getElementById('modal').classList.remove('open'); }

// Close modal on overlay click
document.getElementById('modal').addEventListener('click', function(e) { if (e.target === this) closeModal(); });
</script>
